video_mode_alta_definicion: the video mode reports high definition below 1280x720, so a game rendering at 960x540 keeps its HD interface.

--- a/src/kernel/xboxkrnl/xboxkrnl_video.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_video.cpp
@@ -33,6 +33,10 @@
 #include <rex/system/xtypes.h>
 #include <rex/ui/flags.h>
 
+REXCVAR_DEFINE_BOOL(video_mode_alta_definicion, false, "Display",
+                    "El modo de video se declara de alta definicion aunque sea menor que 1280x720 (un juego que "
+                    "renderiza a 960x540 sigue con la interfaz de HD en vez de la de SD)");
+
 namespace {
 // Display gamma type: 0 - linear, 1 - sRGB (CRT), 2 - BT.709 (HDTV), 3 - power
 constexpr uint32_t kDisplayGammaType = 2;
@@ -239,7 +243,8 @@ void VdQueryVideoMode(X_VIDEO_MODE* video_mode) {
   video_mode->display_height = display_height;
   video_mode->is_interlaced = 0;
   video_mode->is_widescreen = display_width * 3 >= display_height * 4;
-  video_mode->is_hi_def = display_width >= 1280 || display_height >= 720;
+  video_mode->is_hi_def =
+      display_width >= 1280 || display_height >= 720 || REXCVAR_GET(video_mode_alta_definicion);
   video_mode->refresh_rate = refresh_rate_hz;
   video_mode->video_standard = 1;  // NTSC
   video_mode->unknown_0x8a = 0x4A;
