+namespace {
+// x360_diag_resolve: is this resolve destination one of the listed ones, with lines left to log.
+bool DiagDireccion(uint32_t direccion) {
+  const std::string& lista = REXCVAR_GET(x360_diag_resolve);
+  if (lista.empty()) return false;
+  static std::string texto;
+  static std::vector<uint32_t> direcciones;
+  static std::unordered_map<uint32_t, uint32_t> lineas;
+  if (lista != texto) {
+    texto = lista;
+    direcciones.clear();
+    for (size_t i = 0; i < lista.size();) {
+      size_t fin = lista.find(',', i);
+      if (fin == std::string::npos) fin = lista.size();
+      if (fin > i) direcciones.push_back(uint32_t(std::strtoul(lista.substr(i, fin - i).c_str(), nullptr, 16)));
+      i = fin + 1;
+    }
+  }
+  if (std::find(direcciones.begin(), direcciones.end(), direccion) == direcciones.end()) return false;
+  return lineas[direccion]++ < 60;
+}
