+  // modos.x = 1 (k_32_FLOAT): only NaN and infinities out. A 32-bit float target holds negatives: Max Payne 3 keeps its
+  // log luminance there (negative below 1), and with them made 0 its adapted luminance was 0 and the frame burned.
+  if (copia.modos.x == 1) {
+    return vec4(lessThanEqual(abs(t), tope)) * t;  // NaN compares false: 0
