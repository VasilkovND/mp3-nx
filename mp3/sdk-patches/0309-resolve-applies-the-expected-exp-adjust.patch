+REXCVAR_DEFINE_BOOL(x360_resolve_exp_previsto, true, "X360",
+                    "Un resolve con exp bias se escribe ya escalado por el exp_adjust con que se leyo la textura la "
+                    "ultima vez, y esa lectura la muestrea directamente: Max Payne 3 resolvia su escena x2048 y cada "
+                    "lectura (exp_adjust -13) hacia otra copia entera x1/8192 (0,5 ms cada una a 960x540)");
 REXCVAR_DEFINE_BOOL(x360_f14_sanear, true, "X360",
                     "Los resolves de destinos k_32_FLOAT (la cadena de luminancia de GTA IV) se limitan a 0..31.875 (el "
                     "maximo del HDR) y NaN a 0: un pixel de -60000 llevaba la luminancia adaptada a 0 y la exposicion "
@@ -1608,12 +1612,21 @@
