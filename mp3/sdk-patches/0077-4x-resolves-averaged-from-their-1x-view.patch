+  for (uint32_t k = 0; k < n; ++k) {
+    ImagenDk* d = tejas_color_[(vista.edram_base + k) & (kTejas - 1)].dueno;
+    if (!d || (dueno && d != dueno)) return nullptr;
+    dueno = d;
+  }
+  if (!dueno || dueno == &vista || dueno->edram_msaa != 0 || dueno->edram_base != vista.edram_base ||
+      dueno->edram_pitch != 2 * vista.edram_pitch || dueno->edram_formato != vista.edram_formato ||
+      dueno->formato != vista.formato || dueno->alto < 2 * std::min(filas, vista.alto)) {
+    return nullptr;
+  }
+  return dueno;
