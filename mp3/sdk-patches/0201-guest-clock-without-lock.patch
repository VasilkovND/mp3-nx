+// The guest clock without a lock. Every mftb of the generated code and every guest time query lands in
+// UpdateGuestClock; it used to take tick_mutex_ to add the host ticks since the last call to a running count, so the
+// game's threads queued on it (Max Payne 3's job threads had 10-15 % of their samples in that mutex). The ratio only
+// changes in RecomputeGuestTickScalar (at startup), so the guest count is a function of the host count from an anchor
+// (the host and guest counts when the ratio last changed): readers load the anchor and compute, with no shared writes.
+struct GuestClockAnchor {
+  uint64_t host_tick_count;
+  uint64_t guest_tick_count;
+  uint64_t numerator;
+  uint64_t denominator;
+};
+GuestClockAnchor initial_anchor_{Clock::QueryHostTickCount(), 0, 1, 1};
+// Replaced anchors are not freed: a reader may still hold one, and the ratio changes a few times per run.
+std::atomic<const GuestClockAnchor*> anchor_{&initial_anchor_};
+// Serializes the ratio's writers.
 std::mutex tick_mutex_;
 
+uint64_t GuestTicksAt(const GuestClockAnchor& anchor, uint64_t host_tick_count) {
+  const uint64_t host_tick_delta =
+      host_tick_count > anchor.host_tick_count ? host_tick_count - anchor.host_tick_count : 0;
+#if defined(__SIZEOF_INT128__)
+  const uint64_t guest_tick_delta =
+      uint64_t((unsigned __int128)host_tick_delta * anchor.numerator / anchor.denominator);
+#else
+  const uint64_t guest_tick_delta = host_tick_delta * anchor.numerator / anchor.denominator;
+#endif
+  return anchor.guest_tick_count + guest_tick_delta;
+}
