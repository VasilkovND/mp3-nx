                      "carga otra textura en la misma memoria la ve como mucho este tiempo con el contenido viejo");
 REXCVAR_DEFINE_BOOL(x360_texturas_por_escritura, true, "X360",
                     "Una textura cuya memoria el juego escribio en bloque (XMemCpy, XMemDecompress; el port los "
