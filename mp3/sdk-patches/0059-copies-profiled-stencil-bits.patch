+void RenderDk::PerfilCopia(const char* tipo, const ImagenDk* origen, const ImagenDk* destino, uint32_t ancho,
+                           uint32_t alto) {
+  if (!perfilando_ || !nucleo_.TrabajoAbierto()) {
+    return;
+  }
+  CerrarPerfilCopia();
+  if (perfil_copias_.size() >= kCopiasPerfil) {
+    return;
+  }
+  const DkGpuAddr marca = perfil_gpu_ + DkGpuAddr(kMarcasPerfil + perfil_copias_.size()) * 32;
+  dkCmdBufReportCounter(nucleo_.comandos(), DkCounter_Timestamp, marca);
+  CopiaPerfil c{tipo, ancho, alto};
+  if (origen) {
+    c.origen_ancho = origen->ancho;
+    c.origen_alto = origen->alto;
+    c.origen_msaa = origen->edram_msaa;
+    c.origen_formato = uint32_t(origen->formato);
+  }
+  if (destino) {
+    c.destino_ancho = destino->ancho;
+    c.destino_alto = destino->alto;
+    c.destino_msaa = destino->edram_msaa;
+    c.destino_formato = uint32_t(destino->formato);
+  }
+  c.barreras = c.barreras_fin = barreras_ + barreras_fragmentos_;
+  perfil_copias_.push_back(c);
+  perfil_copia_abierta_ = true;
+  perfil_trabajo_ = trabajo_;
 }
 
+void RenderDk::CerrarPerfilCopia() {
+  if (!perfil_copia_abierta_) {
+    return;
+  }
+  perfil_copia_abierta_ = false;
+  if (!nucleo_.TrabajoAbierto()) {
+    perfil_copias_.pop_back();  // its end is not in this work
+    return;
+  }
+  const DkGpuAddr marca = perfil_gpu_ + DkGpuAddr(kMarcasPerfil + perfil_copias_.size() - 1) * 32;
+  dkCmdBufReportCounter(nucleo_.comandos(), DkCounter_Timestamp, marca + 16);
+  perfil_copias_.back().barreras_fin = barreras_ + barreras_fragmentos_;
+}
