       const int32_t exp_adjust = int32_t(f[3] << 13) >> 26;
       const bool fraccion_16 = ((f[1] & 0x3F) == 26 || (f[1] & 0x3F) == 25) && !(f[3] & 0x1) && resuelta->entero16 &&
