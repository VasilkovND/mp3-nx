+void RenderDk::InformeCopiasDelPerfil() {
+  if (perfil_copias_.empty()) {
+    return;
+  }
+  // Each copy, from its start to what came next (its barrier, the copy, the pipeline drain before the next work).
+  auto ms_de = [&](size_t j) {
+    const uint8_t* p = perfil_cpu_ + (kMarcasPerfil + j) * 32;
+    uint64_t t0 = 0, t1 = 0;
+    std::memcpy(&t0, p + 8, sizeof(t0));
+    std::memcpy(&t1, p + 24, sizeof(t1));
+    return t1 >= t0 ? double(t1 - t0) * deko::kNsPorUnidadGpu / 1e6 : 0.0;
+  };
+  struct Grupo {
+    double ms = 0, ms_barrera = 0;
+    uint32_t veces = 0, con_barrera = 0;
+    uint64_t pixeles = 0;
+  };
+  std::map<std::string, Grupo> grupos;
+  std::vector<std::pair<double, size_t>> lista;
+  double total = 0;
+  for (size_t j = 0; j < perfil_copias_.size(); ++j) {
+    const CopiaPerfil& c = perfil_copias_[j];
+    const double ms = ms_de(j);
+    const bool barrera = c.barreras_fin != c.barreras;
+    total += ms;
+    Grupo& g = grupos[c.tipo];
+    g.ms += ms;
+    ++g.veces;
+    g.pixeles += uint64_t(c.ancho) * c.alto;
+    if (barrera) {
+      g.ms_barrera += ms;
+      ++g.con_barrera;
+    }
+    lista.emplace_back(ms, j);
+  }
+  std::string texto;
+  for (const auto& [tipo, g] : grupos) {
+    texto += fmt::format("; {}: {} ({} con barrera) {:.2f} ms, {:.2f} Mpix", tipo, g.veces, g.con_barrera, g.ms,
+                         double(g.pixeles) / 1e6);
+  }
+  REXLOG_INFO("[deko3d] perfil GPU: {} copias del fotograma {} en {:.2f} ms{}", perfil_copias_.size(),
+              perfil_fotograma_, total, texto);
+  std::sort(lista.begin(), lista.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+  for (size_t k = 0; k < std::min<size_t>(lista.size(), 24); ++k) {
+    const size_t j = lista[k].second;
+    const CopiaPerfil& c = perfil_copias_[j];
+    REXLOG_INFO("[deko3d] perfil GPU: copia {} ({:.3f} ms{}): {} {}x{}, de {}x{} msaa {} formato {} a {}x{} msaa {} "
+                "formato {}",
+                j, lista[k].first, c.barreras_fin != c.barreras ? ", con barrera" : "", c.tipo, c.ancho, c.alto,
+                c.origen_ancho, c.origen_alto, c.origen_msaa, c.origen_formato, c.destino_ancho, c.destino_alto,
+                c.destino_msaa, c.destino_formato);
+  }
 }
 
