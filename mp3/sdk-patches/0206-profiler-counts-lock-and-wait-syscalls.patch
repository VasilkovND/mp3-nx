+// The calling thread's slot (searched by handle once per thread; -1 if it is not registered).
+int SlotActual() {
+  static thread_local int slot = -2;
+  if (slot == -2) {
+    slot = -1;
+    const u32 h = threadGetCurHandle();
+    for (size_t i = 0; i < kMaxThreads; ++i) {
+      if (g_slots[i].handle.load(std::memory_order_relaxed) == h) {
+        slot = int(i);
+        break;
+      }
+    }
+  }
+  return slot;
+}
