+/*
+ * The audio threads (the XMA decoder, the audio worker, a game's mixer): each registers itself, and
+ * RexSwitchAudioSoloNucleo3 puts all of them on core 3 alone (1) or back on the whole process, preferring core 3 (0).
+ * On core 3 alone they cannot take the game's cores when they need more than one core; a busy core 3 can then make
+ * them late (the sound stutters), so it is a setting to measure.
+ */
+void RexSwitchRegistrarHiloAudio(void);
+void RexSwitchAudioSoloNucleo3(int solo);
+
 /* Which core the calling thread is running on right now. It can only be asked about oneself. */
 int RexSwitchCurrentCore(void);
 
