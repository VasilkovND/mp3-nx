+      // x360_resolve_exp_previsto: the resolve may have applied this fetch's exp_adjust already (exp_previo); only
+      // what is left is scaled, and the exp_adjust is remembered for the next resolve here.
+      if (!resuelta->profundidad && !fraccion_16 && REXCVAR_GET(x360_resolve_exp_previsto)) {
+        resuelta->exp_leida = int8_t(exp_adjust);
+        resuelta->exp_leida_valida = true;
+      }
+      const int32_t exp_resto = exp_adjust - resuelta->exp_previo;
+      if ((exp_resto || fraccion_16) && !resuelta->profundidad) {
+        if (const ImagenDk* escalada = ResueltaEscalada(*resuelta, exp_resto, fraccion_16)) {
           resuelta = escalada;
