+// The lock is held for a few instructions; a waiter spins, then sleeps 1 us at a time (on Horizon a yield does not
+// let a lower-priority holder on the same core run).
+void ObjectTable::EmpezarLectura() {
+  for (uint32_t vueltas = 0;; ++vueltas) {
+    int32_t v = lectores_.load(std::memory_order_relaxed);
+    if (v >= 0 && lectores_.compare_exchange_weak(v, v + 1, std::memory_order_acquire, std::memory_order_relaxed)) {
+      return;
+    }
+    if (vueltas > 64) rex::thread::Sleep(std::chrono::microseconds(1));
+  }
+}
+
+void ObjectTable::EmpezarEscritura() {
+  for (uint32_t vueltas = 0;; ++vueltas) {
+    int32_t cero = 0;
+    if (lectores_.compare_exchange_weak(cero, -1, std::memory_order_acquire, std::memory_order_relaxed)) {
+      return;
+    }
+    if (vueltas > 64) rex::thread::Sleep(std::chrono::microseconds(1));
+  }
+}
