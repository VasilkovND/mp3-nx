+}
+
+// x360_edram_8bits_a_flotante: the rows an 8-bit color view (format 0) just claimed are carried into the 7e3 views
+// (f3/f12) of the same base, pitch and MSAA as VALUES, a 3D-engine copy that converts RGBA8 -> RGBA16F (Copiar3D),
+// and those views' tiles are marked seen, as a transfer would (the claiming view stays their owner). Why: Max Payne 3
+// tonemaps into base 198's f0 view and the frame's last passes and its final copy read the f12 view of the same tiles;
+// the machinery's own carry points (EdramPreparar at EmpezarPase and Copiar) either never run - the pass in between
+// begins with a whole-target opaque draw, which skips the transfer-in (dibujos.cpp, dibujo_opaco_completo_) and then
+// claims the tiles for the f12 view with its own, stale content - or would reinterpret the 8-bit bits as 7e3
+// (EdramTransferir), not the picture's values. Run 32: "no transfer between the tonemap's resolve and the final one".
+void RenderDk::EdramLlevar8Bits(ImagenDk& vista, uint32_t filas) {
+  if (!REXCVAR_GET(x360_edram_8bits_a_flotante) || !EdramActiva() || vista.profundidad || vista.edram_formato != 0 ||
+      vista.edram_bpp != 4 || vista.edram_versiones.empty()) {
+    return;
+  }
+  filas = std::min(filas, vista.alto);
+  const uint32_t ancho = std::min(vista.ancho, vista.edram_pitch);
+  if (!filas || !ancho) return;
+  ImagenDk* llevadas[4];
+  uint32_t n_llevadas = 0;
+  for (auto& [clave, otra] : destinos_) {
+    // The 7e3 views of these tiles. Format 3 is k_2_10_10_10_FLOAT; a 12 bind (AS_16_16_16_16, what the frame's
+    // final copy reads) never reaches this map as 12: DestinoColor folds it into the f3 image of the same key and
+    // EdramVista's FormatoBase(12) is 3. f3 and f12 are ONE image here (run 65's ten f12 draws land in it), so
+    // matching 3 finds the copy's source; there is no separate f12 destination to also accept.
+    if (otra.serie == vista.serie || otra.profundidad || otra.edram_formato != 3 || otra.edram_bpp != 4 ||
+        otra.edram_base != vista.edram_base || otra.edram_pitch != vista.edram_pitch ||
+        otra.edram_msaa != vista.edram_msaa || otra.edram_versiones.empty()) {
+      continue;
+    }
+    llevadas[n_llevadas++] = &otra;
+    if (n_llevadas == 4) break;  // f3 alone after the fold; a couple more costs nothing
+  }
+  if (!n_llevadas) {
+    EdramLlevar8BitsAviso(vista, "ninguna vista 7e3 (f3/f12) de esa base, pitch y msaa");
+    return;
+  }
+  // As a transfer: the source must be its own content again (a resolve without copy may have given it away), the
+  // destination is written below its pending band. Copiar3D orders itself against the draws and copies before it.
+  RestaurarContenido(vista, true);
+  HacerBorradoPendiente(vista);
+  CompletarBanda(vista, filas, false, 0);
+  for (uint32_t i = 0; i < n_llevadas; ++i) {
+    ImagenDk& otra = *llevadas[i];
+    const uint32_t filas_otra = std::min(filas, otra.alto);
+    const uint32_t n = TejasDeFilas(vista, filas_otra);
+    AntesDeCambiarDestino(&otra);
+    CompletarBanda(otra, filas_otra, false, 0);
+    if (!Copiar3D(vista, 0, 0, ancho, filas_otra, otra, 0, 0)) {
+      otra.edram_generacion = UINT32_MAX;  // nothing carried: the tiles stay to take as a transfer
+      EdramLlevar8BitsAviso(vista, "Copiar3D no pudo llevarlas");
+      continue;
+    }
+    for (uint32_t k = 0; k < n && k < otra.edram_versiones.size(); ++k) {
+      otra.edram_versiones[k] = tejas_color_[(vista.edram_base + k) & (kTejas - 1)].version;
+    }
+    ++edram_llevados_8bits_;
+    edram_pixeles_ += uint64_t(ancho) * filas_otra;
+    if (EdramRegistrando() || deko::AhoraNs() >= edram_llevados_8bits_siguiente_) {
+      // Once per 10 s outside a dump frame: the next run's log names the carry without waiting for one.
+      edram_llevados_8bits_siguiente_ = deko::AhoraNs() + uint64_t(10) * 1000000000ull;
+      REXLOG_INFO("[edram] c {:03X} f0 {} -> {:03X} f3 {}: filas 0-{}, de 8 bits como valores", vista.edram_base,
+                  vista.edram_pitch, otra.edram_base, otra.edram_pitch, filas_otra);
+    }
+  }
+}
+
+// Why a carry did not happen, at most one line per 10 s: the counter in the 300-frame [edram] report says HOW MANY
+// carries ran; this says why one that should have (an 8-bit view claimed rows, the cvar is on) did not.
+void RenderDk::EdramLlevar8BitsAviso(const ImagenDk& vista, const char* razon) {
+  if (deko::AhoraNs() < edram_llevados_8bits_aviso_siguiente_) return;
+  edram_llevados_8bits_aviso_siguiente_ = deko::AhoraNs() + uint64_t(10) * 1000000000ull;
+  REXLOG_INFO("[edram] c {:03X} f0 {} ({} filas): de 8 bits a flotante no llevado, {}", vista.edram_base,
+              vista.edram_pitch, vista.edram_filas, razon);
 }
 
