+      int32_t exp_previo = 0;
+      if (REXCVAR_GET(x360_resolve_exp_previsto) && !se_lee && !encoger && !frontal) {
+        const bool entera = dx == 0 && dy == 0 && ancho == resuelta->imagen.ancho && alto == resuelta->imagen.alto;
