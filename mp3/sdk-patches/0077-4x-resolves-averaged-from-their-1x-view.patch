+// straight from it, as the Xenos resolve averages the samples, instead of a transfer that kept one of the four.
+ImagenDk* RenderDk::EdramVistaReducible(const ImagenDk& vista, uint32_t filas) {
+  if (!EdramActiva() || !REXCVAR_GET(x360_edram_reduccion_directa) || vista.profundidad || vista.edram_msaa != 2 ||
