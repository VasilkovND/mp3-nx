+// deko3d renderer: the EDRAM shared by its views (x360_edram_compartida). See render.h.
+//
+// The Xbox 360 draws into 10 MB of EDRAM: 2048 tiles of 80x16 32-bit samples (40x16 of 64 bits). A render target is a
+// view of it: a base tile, a pitch, an MSAA mode and a format. The renderer keeps each view as an image of its own
+// (destinos.cpp), which is enough while a game reads a view only the way it drew it. GTA IV does not:
+//  - it draws its HDR scene at 1280x720 and resolves the same tiles as 640x360 with 4x MSAA, which the hardware turns
+//    into a downsample (each 2x2 averaged into one texel); the luminance chain does it again at 320 -> 160, 80 -> 40;
+//  - it restores the scene's depth as 640x360 4x and tests its lights against it as 1280x720;
+//  - one base is 8-bit color, 7e3 and 32-bit float in turn, and its clears are draws at 640x360 4x.
+// As separate images each of those read an image nobody drew: the lights saw no depth, the downsamples were empty.
+//
+// Here each tile remembers the view that wrote it last and a version. A view about to be drawn or resolved first gets
+// the tiles another view wrote since it last held them: a draw maps each of its samples to the tile and the position
+// it lives at in EDRAM, reads that sample from the writer's image and reinterprets the bits when the formats differ
+// (Xenia's ownership transfers, at one value per pixel: going to more samples per pixel averages them, to fewer
+// replicates them). A view claims the rows its draws and clears wrote when its pass ends. Color and depth are kept
+// apart: a color tile is never read as depth or the other way round.
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <algorithm>
+#include <cstring>
+
+#include <rex/ui/deko3d/compilador.h>
+#include <rex/x360/deko/render.h>
+
+REXCVAR_DECLARE(bool, x360_copias_sin_barrera);
+
+REXCVAR_DEFINE_BOOL(x360_edram_compartida, true, "X360",
+                    "Las vistas de un mismo EDRAM (otro pitch, MSAA o formato sobre las mismas tejas) ven los mismos "
+                    "datos: se transfieren al cambiar de vista, como en el hardware");
+REXCVAR_DEFINE_BOOL(x360_edram_estencil, true, "X360",
+                    "Las transferencias de profundidad entre vistas del EDRAM llevan tambien el stencil (8 pasadas)");
+REXCVAR_DEFINE_BOOL(x360_edram_z_por_pixel, true, "X360",
+                    "La profundidad 2x MSAA pasa a la vista 1x de la misma base y pitch pixel a pixel (GTA IV dibuja su "
+                    "G-buffer 2x entero, sin tiles, y restaura la profundidad para las luces escribiendo sus bits como "
+                    "color sobre la misma EDRAM)");
+REXCVAR_DEFINE_BOOL(x360_edram_z_por_color, true, "X360",
+                    "Un pase con color de 8 bits y profundidad en la misma base escribe la profundidad como color "
+                    "(GTA IV la restaura asi para las luces): la profundidad recibe la ultima resuelta de esa base");
+REXCVAR_DEFINE_BOOL(x360_edram_registro, false, "X360",
+                    "Registra cada transferencia entre vistas del EDRAM (siempre en el fotograma de un volcado)");
+
