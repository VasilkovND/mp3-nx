+namespace {
+// Bytes per texel of the formats resolves write (texture formats).
+uint32_t BytesTexelResuelta(uint32_t formato) {
+  switch (formato) {
+    case 26:  // k_16_16_16_16
+    case 32:  // k_16_16_16_16_FLOAT
+    case 37:  // k_32_32_FLOAT
+      return 8;
+    case 38:  // k_32_32_32_32_FLOAT
+      return 16;
+    default:
+      return 4;
+  }
+}
+}  // namespace
+
+// GTA IV renders its G-buffer in bands it tiles itself (1280x256 then 1280x464 through the same EDRAM) and resolves
+// each band into the same texture, the second one with the copy base moved down 256 rows (the destination height
+// 464). Textures here are images keyed by base, so the second band went into a 1280x464 texture the game never samples,
+// and the lower two thirds of every G-buffer texture stayed black. A copy base that lies a whole number of rows into a
+// resolved texture of the same width and format is that texture, from that row.
+RenderDk::Resuelta* RenderDk::ResueltaDeBanda(uint32_t base, uint32_t ancho, uint32_t pitch, uint32_t formato,
+                                              uint32_t& filas) {
+  filas = 0;
+  if (resueltas_.count(base)) return nullptr;
+  const uint32_t bytes_fila = pitch * BytesTexelResuelta(formato);
+  if (!bytes_fila) return nullptr;
+  for (auto& [b, r] : resueltas_) {
+    if (b >= base || r.formato_guest != formato || r.imagen.ancho != ancho) continue;
+    const uint32_t delta = base - b;
+    if (delta % (bytes_fila * 32) != 0) continue;  // whole rows of 32-texel tiles
+    const uint32_t f = delta / bytes_fila;
+    if (f == 0 || f >= r.imagen.alto) continue;
+    filas = f;
+    return &r;
+  }
+  return nullptr;
 }
 
