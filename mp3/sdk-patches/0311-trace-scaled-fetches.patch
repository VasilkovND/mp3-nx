+                    "copia escalada (la escena y el bloom de MP3 resuelven la misma direccion a traves de varias "
+                    "vistas de formato con biases de copia distintos; un error de potencia de dos en el neto es lo "
+                    "que blanquea la entrada del tonemap)");
 REXCVAR_DECLARE(bool, x360_resolve_exp_previsto);  // destinos.cpp
 REXCVAR_DECLARE(bool, x360_resolve_16_fijo);  // destinos.cpp
 
