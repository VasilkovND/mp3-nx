+Result __wrap_svcArbitrateLock(u32 wait_tag, u32* tag_location, u32 self_tag) {
+  const u64 desde = armGetSystemTick();
+  const Result rc = __real_svcArbitrateLock(wait_tag, tag_location, self_tag);
+  Anotar(kArbLock, desde);
+  return rc;
+}
+
+Result __wrap_svcArbitrateUnlock(u32* tag_location) {
+  const u64 desde = armGetSystemTick();
+  const Result rc = __real_svcArbitrateUnlock(tag_location);
+  Anotar(kArbUnlock, desde);
+  return rc;
+}
+
+Result __wrap_svcWaitForAddress(void* address, u32 arb_type, s64 value, s64 timeout) {
+  const u64 desde = armGetSystemTick();
+  const Result rc = __real_svcWaitForAddress(address, arb_type, value, timeout);
+  Anotar(kEsperaDir, desde);
+  return rc;
+}
+
+Result __wrap_svcSignalToAddress(void* address, u32 signal_type, s32 value, s32 count) {
+  const u64 desde = armGetSystemTick();
+  const Result rc = __real_svcSignalToAddress(address, signal_type, value, count);
+  Anotar(kSenalDir, desde);
+  return rc;
+}
+
+Result __wrap_svcWaitProcessWideKeyAtomic(u32* key, u32* tag_location, u32 self_tag, u64 timeout) {
+  const u64 desde = armGetSystemTick();
+  const Result rc = __real_svcWaitProcessWideKeyAtomic(key, tag_location, self_tag, timeout);
+  Anotar(kEsperaCond, desde);
+  return rc;
+}
+
+void __wrap_svcSignalProcessWideKey(u32* key, s32 num) {
+  const u64 desde = armGetSystemTick();
+  __real_svcSignalProcessWideKey(key, num);
+  Anotar(kSenalCond, desde);
+}
+
