 // A rectangle from gl_VertexID (a triangle strip): its corners in clip space (x0, y0, x1, y1, y up) and the texture
 // coordinates that go with them.
+// The sharpening amount goes to the fragment shader with the rectangle (0: a plain bilinear copy).
 constexpr char kVsCopia[] = R"(#version 460
-layout(std140, binding = 0) uniform Copia { vec4 destino; vec4 origen; } c;
+layout(std140, binding = 0) uniform Copia { vec4 destino; vec4 origen; vec4 nitidez; } c;
 layout(location = 0) out vec2 v_uv;
+layout(location = 1) flat out float v_nitidez;
 void main() {
   vec2 t = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1));
   gl_Position = vec4(mix(c.destino.xy, c.destino.zw, t), 0.0, 1.0);
   v_uv = mix(c.origen.xy, c.origen.zw, t);
+  v_nitidez = c.nitidez.x;
 }
 )";
+// The frame stretched to the screen (bilinear), sharpened as AMD FidelityFX FSR 1's RCAS does it: the center and its
+// four neighbors one source texel away; the negative lobe that keeps the result inside their range (no ringing),
+// limited to -0.1875 and scaled by the sharpening amount. Here it runs on the bilinear samples of the stretch, in one
+// pass (FSR runs it after its own upscale).
 constexpr char kFsCopia[] = R"(#version 460
 layout(binding = 0) uniform sampler2D salida;
 layout(location = 0) in vec2 v_uv;
+layout(location = 1) flat in float v_nitidez;
 layout(location = 0) out vec4 o;
-void main() { o = vec4(texture(salida, v_uv).rgb, 1.0); }
+void main() {
+  vec3 e = texture(salida, v_uv).rgb;
+  if (v_nitidez <= 0.0) { o = vec4(e, 1.0); return; }
+  vec2 px = 1.0 / vec2(textureSize(salida, 0));
+  vec3 b = texture(salida, v_uv + vec2(0.0, -px.y)).rgb;
+  vec3 d = texture(salida, v_uv + vec2(-px.x, 0.0)).rgb;
+  vec3 f = texture(salida, v_uv + vec2(px.x, 0.0)).rgb;
+  vec3 h = texture(salida, v_uv + vec2(0.0, px.y)).rgb;
+  vec3 mn4 = min(min(b, d), min(f, h));
+  vec3 mx4 = max(max(b, d), max(f, h));
+  vec3 hit_min = min(mn4, e) / max(4.0 * mx4, vec3(1.0 / 65536.0));
+  vec3 hit_max = (1.0 - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1.0 / 65536.0));
+  vec3 lobe3 = max(-hit_min, hit_max);
+  float lobe = max(-0.1875, min(max(lobe3.r, max(lobe3.g, lobe3.b)), 0.0)) * v_nitidez;
+  o = vec4(clamp((lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0), 0.0, 1.0), 1.0);
+}
 )";
