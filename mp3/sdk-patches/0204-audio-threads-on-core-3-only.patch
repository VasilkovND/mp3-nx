+namespace {
+std::mutex g_hilos_audio_mutex;
+Handle g_hilos_audio[8];
+int g_num_hilos_audio = 0;
+}  // namespace
+
+void RexSwitchRegistrarHiloAudio(void) {
+  Thread* yo = threadGetSelf();
+  const Handle h = (yo != nullptr) ? yo->handle : CUR_THREAD_HANDLE;
+  if (h == CUR_THREAD_HANDLE) return;  // only a real handle can be changed from another thread
+  std::lock_guard<std::mutex> lock(g_hilos_audio_mutex);
+  if (g_num_hilos_audio < 8) g_hilos_audio[g_num_hilos_audio++] = h;
+}
+
+void RexSwitchAudioSoloNucleo3(int solo) {
+  u64 proceso = 0;
+  if (R_FAILED(svcGetInfo(&proceso, InfoType_CoreMask, CUR_PROCESS_HANDLE, 0)) || !(proceso & 0x8)) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(g_hilos_audio_mutex);
+  for (int i = 0; i < g_num_hilos_audio; ++i) {
+    svcSetThreadCoreMask(g_hilos_audio[i], 3, solo ? u64(0x8) : proceso);
+  }
+}
