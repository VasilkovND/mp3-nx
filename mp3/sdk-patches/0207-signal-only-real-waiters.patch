+  void DespertarSiHace(void* direccion, int32_t cuantos) {
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    if (esperando_.load(std::memory_order_relaxed) > 0) {
+      svcSignalToAddress(direccion, SignalType_Signal, 0, cuantos);
+    }
+    if (sondeado_.load(std::memory_order_relaxed) > 0) {
+      DespertarSondeos();
+    }
+  }
+  // Around a kernel wait on the object's own address.
+  void EmpezarEspera() {
+    esperando_.fetch_add(1, std::memory_order_relaxed);
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+  }
+  void AcabarEspera() { esperando_.fetch_sub(1, std::memory_order_relaxed); }
+#endif
