x360_texturas_por_escritura: a game's bulk writes to physical memory (escrituras.h, marked by the port's hooks of
XMemCpy, XMemCpyStreaming and XMemDecompress) make the texture cache recheck the textures there at their next use,
instead of on a timer; the draws' per-fetch cache holds for one frame. The report says how many content changes were
found with and without a write before them (the hooks' coverage).

--- /dev/null
+++ b/include/rex/x360/escrituras.h
@@ -0,0 +1,53 @@
+#pragma once
+
+// Guest physical memory the CPU wrote in bulk (a game's XMemCpy / XMemCpyStreaming / XMemDecompress, hooked by the
+// game's port): 64 KB pages stamped with a counter. The texture cache (texturas.cpp) rechecks a texture as soon as its
+// bytes were written, instead of waiting for its periodic recheck: Max Payne 3 streams textures into memory another
+// texture used, and with only the periodic check the old one was shown for up to 39 frames.
+
+#include <array>
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+
+namespace rex::x360 {
+
+inline constexpr uint32_t kEscrituraPaginaLog2 = 16;
+inline constexpr uint32_t kEscrituraPaginas = 0x20000000u >> kEscrituraPaginaLog2;
+
+// The stamp of the last bulk write to each page (0: never), and the counter the stamps come from.
+inline std::array<std::atomic<uint32_t>, kEscrituraPaginas> g_escritura_paginas{};
+inline std::atomic<uint32_t> g_escritura_contador{1};
+inline std::atomic<uint64_t> g_escritura_bytes{0};  // marked so far (the renderer reports it)
+
+// A bulk write of `bytes` at guest physical address `fisica` (any thread).
+inline void MarcarEscritura(uint32_t fisica, uint32_t bytes) {
+  if (!bytes) return;
+  fisica &= 0x1FFFFFFFu;
+  const uint32_t marca = g_escritura_contador.fetch_add(1, std::memory_order_relaxed) + 1;
+  const uint64_t fin = uint64_t(fisica) + bytes - 1;
+  const uint32_t primera = fisica >> kEscrituraPaginaLog2;
+  const uint32_t ultima = uint32_t(std::min<uint64_t>(fin, 0x1FFFFFFFu) >> kEscrituraPaginaLog2);
+  for (uint32_t p = primera; p <= ultima; ++p) {
+    g_escritura_paginas[p].store(marca, std::memory_order_release);
+  }
+  g_escritura_bytes.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+// The counter now: a check that reads the bytes after taking it sees every write stamped up to it.
+inline uint32_t MarcaEscrituraActual() { return g_escritura_contador.load(std::memory_order_acquire); }
+
+// Whether [fisica, fisica + bytes) was written after `desde` (a MarcaEscrituraActual taken before reading it).
+inline bool EscritoDesde(uint32_t fisica, uint32_t bytes, uint32_t desde) {
+  if (!bytes) return false;
+  fisica &= 0x1FFFFFFFu;
+  const uint64_t fin = uint64_t(fisica) + bytes - 1;
+  const uint32_t primera = fisica >> kEscrituraPaginaLog2;
+  const uint32_t ultima = uint32_t(std::min<uint64_t>(fin, 0x1FFFFFFFu) >> kEscrituraPaginaLog2);
+  for (uint32_t p = primera; p <= ultima; ++p) {
+    if (g_escritura_paginas[p].load(std::memory_order_acquire) >= desde) return true;
+  }
+  return false;
+}
+
+}  // namespace rex::x360
