+REXCVAR_DEFINE_STRING(x360_diag_ps, "", "X360",
+                      "Diagnostico: los dibujos con estos pixel shaders (huellas de contenedor en hex, separadas por "
+                      "comas) escriben en el log por donde salen de Dibujar y con que pase, encuadre y destino (40 "
+                      "lineas por shader como mucho)");
 
+namespace {
+// x360_diag_ps: is this pixel shader one of the listed ones, with lines left to log.
+bool DiagPs(const rex::x360::EntradaShader* ps) {
+  if (!ps) return false;
+  const std::string& lista = REXCVAR_GET(x360_diag_ps);
+  if (lista.empty()) return false;
+  static std::string texto;
+  static std::vector<uint64_t> huellas;
+  static std::unordered_map<uint64_t, uint32_t> lineas;
+  if (lista != texto) {
+    texto = lista;
+    huellas.clear();
+    for (size_t i = 0; i < lista.size();) {
+      size_t fin = lista.find(',', i);
+      if (fin == std::string::npos) fin = lista.size();
+      if (fin > i) huellas.push_back(std::strtoull(lista.substr(i, fin - i).c_str(), nullptr, 16));
+      i = fin + 1;
+    }
+  }
+  if (std::find(huellas.begin(), huellas.end(), ps->huella_contenedor) == huellas.end()) return false;
+  return lineas[ps->huella_contenedor]++ < 40;
+}
