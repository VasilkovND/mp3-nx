+const ImagenDk* RenderDk::ResueltaEscalada(const ImagenDk& resuelta, int32_t exp_adjust, bool fraccion_16) {
+  if (escaladas_.size() > 64) {  // resolves recreated at other sizes leave theirs behind
+    for (auto& [clave, c] : escaladas_) {
+      DestruirImagen(c.imagen);
+    }
+    escaladas_.clear();
+  }
+  ConvertidaSigno& c = escaladas_[(resuelta.serie << 9) | (fraccion_16 ? 0x100u : 0u) | uint32_t(exp_adjust & 0xFF)];
+  const float escala = std::ldexp(fraccion_16 ? 1.0f / 65535.0f : 1.0f, exp_adjust);
+  if (!c.imagen.viva) {
+    const bool flotante = resuelta.formato == DkImageFormat_R32_Float || resuelta.formato == DkImageFormat_RG32_Float;
+    if (!CrearImagen(c.imagen, DkImageType_2D, flotante ? resuelta.formato : DkImageFormat_RGBA16_Float, resuelta.ancho,
+                     resuelta.alto, 1, 1, DkImageFlags_UsageRender, "resuelta con exp_adjust")) {
+      return nullptr;
+    }
+    REXLOG_INFO("[deko3d] resuelta {}x{} leida con exp_adjust {}{} (x{}): copia escalada", resuelta.ancho, resuelta.alto,
+                exp_adjust, fraccion_16 ? " como fraccion de 16 bits" : "", escala);
+  }
+  if (c.version != resuelta.version) {
+    if (!Copiar3D(resuelta, 0, 0, resuelta.ancho, resuelta.alto, c.imagen, 0, 0, nullptr, false, escala)) {
+      return nullptr;
+    }
+    OlvidarEstado();  // the copy bound its own target and shaders; the draw binds its pass again
+    c.version = resuelta.version;
+    ++c.imagen.version;
+  }
+  return &c.imagen;
+}
