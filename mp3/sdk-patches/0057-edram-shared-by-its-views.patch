+
+struct Geometria {
+  uint32_t sx, sy;        // samples per pixel across and down (2x MSAA: 1x2, 4x: 2x2)
+  uint32_t ancho_teja;    // samples across a tile: 80, 40 for 64-bit formats
+  uint32_t tejas_fila;    // tiles across the view
+};
+
+Geometria GeometriaDe(const ImagenDk& v) {
+  Geometria g;
+  g.sx = v.edram_msaa >= 2 ? 2 : 1;
+  g.sy = v.edram_msaa >= 1 ? 2 : 1;
+  g.ancho_teja = v.edram_bpp == 8 ? 40 : 80;
+  // As Xenia: the pitch in 32-bit tiles, twice that for 64-bit formats.
+  g.tejas_fila = std::max(1u, (v.edram_pitch * g.sx + 79) / 80) * (v.edram_bpp / 4);
+  return g;
+}
+
+// The tiles past the base that the view's first `filas` rows take, up to its limit.
+uint32_t TejasDeFilas(const ImagenDk& v, uint32_t filas) {
+  const Geometria g = GeometriaDe(v);
+  const uint32_t filas_de_tejas = (filas * g.sy + 15) / 16;
+  return std::min({filas_de_tejas * g.tejas_fila, v.edram_tope, kTejas});
+}
+
+// The color target formats as the EDRAM holds them: the aliases are the same bits.
+uint32_t FormatoBase(uint32_t formato) {
+  return formato == 12 ? 3 : formato == 10 ? 2 : formato == 1 ? 0 : formato;
+}
+
+// The color transfer. Uniforms (ivec4): destination and source {base, tiles per row, sx | sy << 4 | tile width << 8,
+// guest format}, then {first tile, tiles, reinterpret, average}. The tiles are absolute (0-2047): the destination pixel
+// is drawn only if one of its samples lies in [first, first + tiles).
+constexpr const char* kFsEdramComun = R"(#version 460
+layout(std140, binding = 0) uniform Transferencia {
+  ivec4 destino;
+  ivec4 origen;
+  ivec4 tejas;
+} t;
+
+// Integer division on this GPU is a float estimate (uam warns of the precision lost): corrected to the exact quotient.
+int Dividir(int a, int b) {
+  int q = int(float(a) / float(b));
+  if (q * b > a) --q;
+  else if ((q + 1) * b <= a) ++q;
+  return q;
+}
+
+// The source pixel that holds this destination sample, or (-1, -1) if the sample is not in the tiles transferred.
+// sx and sy are 1 or 2: shifts.
+ivec2 MuestraOrigen(ivec2 pixel, int i, int j) {
+  int lx = (t.destino.z >> 1) & 1, ly = (t.destino.z >> 5) & 1, ancho = t.destino.z >> 8;
+  int x = (pixel.x << lx) + i, y = (pixel.y << ly) + j;
+  int columna = Dividir(x, ancho);
+  int teja = (t.destino.x + (y >> 4) * t.destino.y + columna) & 2047;
+  if (((teja - t.tejas.x) & 2047) >= t.tejas.y) return ivec2(-1);
+  if (t.tejas.w == 2) return pixel;  // the same pixel (x360_edram_z_por_pixel)
+  int ox = x - columna * ancho, oy = y & 15;
+  int relativa = (teja - t.origen.x) & 2047;
+  int fila = Dividir(relativa, t.origen.y);
+  int olx = (t.origen.z >> 1) & 1, oly = (t.origen.z >> 5) & 1, oancho = t.origen.z >> 8;
+  int fx = (relativa - fila * t.origen.y) * oancho + ox, fy = fila * 16 + oy;
+  return ivec2(fx >> olx, fy >> oly);
+}
+)";
+
+constexpr const char* kFsEdramColor = R"(
+layout(binding = 0) uniform sampler2D fuente;
+layout(location = 0) out vec4 color;
+
+// The 7e3 floats of k_2_10_10_10_FLOAT (DirectXTex, as Xenia's PreClampedFloat32To7e3 and Float7e3To32).
+uint A7e3(float f) {
+  uint u = floatBitsToUint(clamp(f, 0.0, 31.875));
+  uint sesgado = u < 0x3E800000u ? (((u & 0x7FFFFFu) | 0x800000u) >> min(125u - (u >> 23), 24u)) : u - (124u << 23);
+  return ((sesgado + 0x7FFFu + ((sesgado >> 16) & 1u)) >> 16) & 0x3FFu;
+}
+float De7e3(uint f) {
+  f &= 0x3FFu;
+  if (f == 0u) return 0.0;
+  uint m = f & 0x7Fu, e = f >> 7;
+  if (e == 0u) {
+    int msb = findMSB(m);
+    e = uint(1 - (7 - msb));
+    m = (m << uint(7 - msb)) & 0x7Fu;
+  }
+  return uintBitsToFloat(((e + 124u) << 23) | (m << 16));
+}
+
+uint Empaquetar(int f, vec4 v) {
+  if (f == 2) {
+    uvec4 u = uvec4(round(clamp(v, 0.0, 1.0) * vec4(1023.0, 1023.0, 1023.0, 3.0)));
+    return u.r | (u.g << 10) | (u.b << 20) | (u.a << 30);
+  }
+  if (f == 3) {
+    return A7e3(v.r) | (A7e3(v.g) << 10) | (A7e3(v.b) << 20) | (uint(round(clamp(v.a, 0.0, 1.0) * 3.0)) << 30);
+  }
+  if (f == 4) {
+    ivec2 i = ivec2(round(clamp(v.rg * (1.0 / 32.0), -1.0, 1.0) * 32767.0));
+    return (uint(i.x) & 0xFFFFu) | (uint(i.y) << 16);
+  }
+  if (f == 6) return packHalf2x16(v.rg);
+  if (f == 14) return floatBitsToUint(v.r);
+  return packUnorm4x8(v);
+}
+
+vec4 Desempaquetar(int f, uint b) {
+  if (f == 2) {
+    return vec4(float(b & 0x3FFu), float((b >> 10) & 0x3FFu), float((b >> 20) & 0x3FFu), 0.0) / 1023.0 +
+           vec4(0.0, 0.0, 0.0, float(b >> 30) / 3.0);
+  }
+  if (f == 3) return vec4(De7e3(b), De7e3(b >> 10), De7e3(b >> 20), float(b >> 30) / 3.0);
+  if (f == 4) {
+    vec2 c = vec2(float(int(b << 16) >> 16), float(int(b) >> 16)) / 32767.0;
+    return vec4(max(c, vec2(-1.0)) * 32.0, 0.0, 0.0);
+  }
+  // Float targets (16_16_FLOAT, 32_FLOAT) given another format's bits: 0. Read as floats, 7e3 and 8-bit bits are
+  // values up to +-1e34; GTA IV's luminance chain (32_FLOAT over the HDR scene's EDRAM) kept some, its log-average
+  // went to minus thousands, the adapted luminance to 0 and the exposure to white.
+  if (f == 6 || f == 14) return vec4(0.0);
+  return unpackUnorm4x8(b);
+}
+
+void main() {
+  ivec2 pixel = ivec2(gl_FragCoord.xy);
+  int sx = t.destino.z & 15, sy = (t.destino.z >> 4) & 15;
+  vec4 suma = vec4(0.0);
+  int n = 0;
+  for (int j = 0; j < sy; ++j) {
+    for (int i = 0; i < sx; ++i) {
+      ivec2 p = MuestraOrigen(pixel, i, j);
+      if (p.x < 0) continue;
+      vec4 v = texelFetch(fuente, p, 0);
+      if (t.tejas.z == 1) {
+        v = Desempaquetar(t.destino.w, Empaquetar(t.origen.w, v));
+      } else if (t.origen.w == 3) {
+        // A 7e3 target holds what its writes were clamped to; the host image (RGBA16_Float) does not clamp.
+        // NaN compares false (as the resolve's kFsCopia7e3): 0. clamp() would give 31.875 on this GPU, a white pixel.
+        v = vec4(greaterThan(v, vec4(0.0))) * min(v, vec4(31.875, 31.875, 31.875, 1.0));
+      }
+      suma += v;
+      ++n;
+      if (t.tejas.w == 0) break;
+    }
+    if (n > 0 && t.tejas.w == 0) break;
+  }
+  if (n == 0) discard;
+  color = suma / float(n);
+}
+)";
+
+// Depth: the first sample's depth, written with gl_FragDepth. With t.tejas.z = 1 + bit, the stencil instead: the pixel
+// is kept only where that bit of the source's stencil is set (the draw writes that bit with a stencil replace).
+constexpr const char* kFsEdramProfundidad = R"(
+layout(binding = 0) uniform sampler2D fuente;
+layout(binding = 1) uniform usampler2D estencil;
+void main() {
+  ivec2 pixel = ivec2(gl_FragCoord.xy);
+  int sx = t.destino.z & 15, sy = (t.destino.z >> 4) & 15;
+  ivec2 p = ivec2(-1);
+  for (int j = 0; j < sy && p.x < 0; ++j) {
+    for (int i = 0; i < sx && p.x < 0; ++i) {
+      p = MuestraOrigen(pixel, i, j);
+    }
+  }
+  if (p.x < 0) discard;
+  if (t.tejas.z > 0) {
+    // destino.w bit 8: the stencil is not the source's but GTA IV's restore rule, 0xFF where there is depth, 0x80
+    // where there is none (the sky).
+    if ((t.destino.w & 0x100) != 0) {
+      if (texelFetch(fuente, p, 0).r == 0.0) discard;  // the second pass writes 0xFF where there is depth
+    } else if (((texelFetch(estencil, p, 0).r >> uint(t.tejas.z - 1)) & 1u) == 0u) {
+      discard;
+    }
+  }
+  gl_FragDepth = texelFetch(fuente, p, 0).r;
+}
+)";
+
+}  // namespace
+
+bool RenderDk::EdramActiva() const { return REXCVAR_GET(x360_edram_compartida); }
+
+void RenderDk::EdramVista(ImagenDk& imagen, uint32_t base, uint32_t pitch, uint32_t msaa, uint32_t formato) {
+  imagen.edram_base = base & (kTejas - 1);
+  imagen.edram_pitch = pitch;
+  imagen.edram_msaa = msaa & 0x3;
+  imagen.edram_formato = imagen.profundidad ? formato : FormatoBase(formato);
+  imagen.edram_bpp = !imagen.profundidad && (formato == 5 || formato == 7 || formato == 15) ? 8 : 4;
+  imagen.edram_tope = kTejas - imagen.edram_base;
+  imagen.edram_tope_fijo = imagen.edram_tope;
+  imagen.edram_filas = 0;
+  imagen.edram_versiones.assign(kTejas, 0);
+}
+
+// The views bound together cannot overlap: a view holds at most the tiles up to the next base bound with it, in that
+// pass or any before. GTA IV's G-buffer (three 2x MSAA targets 512 tiles apart, a 256-row band each) is drawn whole in
+// one pass (gta4_sin_tiling): its images are 720 rows tall, and without this each would claim the next one's tiles,
+// also in the passes that bind one of them alone (the transfers went round 200 -> 400 -> 600 every pass).
+void RenderDk::EdramTopes(const std::array<ImagenDk*, 5>& imagenes) {
+  for (uint32_t i = 0; i < 5; ++i) {
+    ImagenDk* v = imagenes[i];
+    if (!v || !v->edram_bpp) continue;
+    uint32_t tope = kTejas;
+    for (uint32_t j = 0; j < 5; ++j) {
+      const ImagenDk* o = imagenes[j];
+      if (!o || o == v || !o->edram_bpp || o->profundidad != v->profundidad || o->edram_base <= v->edram_base) continue;
+      tope = std::min(tope, o->edram_base - v->edram_base);
+    }
+    // Nor past the end of the EDRAM: the hardware wraps there, but a target drawn whole (gta4_sin_tiling) at 600 took
+    // 000-3A0 that way, over the first G-buffer target, and they overwrote each other on every pass.
+    tope = std::min(tope, kTejas - v->edram_base);
+    v->edram_tope_fijo = std::min(v->edram_tope_fijo, tope);
+    tope = v->edram_tope_fijo;
+    if (tope != v->edram_tope) {
+      v->edram_tope = tope;
+      v->edram_generacion = UINT32_MAX;  // other tiles: looked at again
+    }
+  }
+}
+
+void RenderDk::EdramPreparar(ImagenDk& vista, uint32_t filas) {
+  if (!EdramActiva() || !vista.edram_bpp || vista.edram_versiones.empty()) return;
+  // Nobody claimed anything since all of it was found up to date: nothing to look at (most pass changes).
+  const uint32_t generacion = vista.profundidad ? generacion_z_ : generacion_color_;
+  if (vista.edram_generacion == generacion) return;
+  auto& tejas = vista.profundidad ? tejas_z_ : tejas_color_;
+  const uint32_t n = TejasDeFilas(vista, std::min(filas, vista.alto));
+  bool preparada = false;
+  for (uint32_t k = 0; k < n;) {
+    const TejaEdram& t = tejas[(vista.edram_base + k) & (kTejas - 1)];
+    if (!t.dueno || t.dueno == &vista || vista.edram_versiones[k] == t.version) {
+      ++k;
+      continue;
+    }
+    ImagenDk* dueno = t.dueno;
+    uint32_t fin = k + 1;
+    while (fin < n) {
+      const TejaEdram& u = tejas[(vista.edram_base + fin) & (kTejas - 1)];
+      if (u.dueno != dueno || vista.edram_versiones[fin] == u.version) break;
+      ++fin;
+    }
+    if (!preparada) {
+      // What the view holds must be its own content before part of it is replaced: a clear asked for earlier, the
+      // content a resolve without copy gave away.
+      preparada = true;
+      RestaurarContenido(vista, true);
+      HacerBorradoPendiente(vista);
+    }
+    // A clear's tiles, all of one claim: a clear of the same rows here (a transfer draw costs 9 for depth).
+    bool una_borrada = t.borrada;
+    for (uint32_t j = k + 1; j < fin && una_borrada; ++j) {
+      const TejaEdram& u = tejas[(vista.edram_base + j) & (kTejas - 1)];
+      una_borrada = u.borrada && u.version == t.version;
+    }
+    if (!una_borrada || !EdramBorrarComo(*dueno, t, vista, k, fin - k)) {
+      EdramTransferir(*dueno, vista, k, fin - k);
+    }
+    for (uint32_t j = k; j < fin; ++j) {
+      vista.edram_versiones[j] = tejas[(vista.edram_base + j) & (kTejas - 1)].version;
+    }
+    k = fin;
+  }
+  if (filas >= std::min(vista.alto, std::max(720u, vista.alto_usado))) {
+    vista.edram_generacion = generacion;
+  }
+}
+
+void RenderDk::EdramReclamar(ImagenDk& vista, uint32_t filas, const float* borrado) {
+  if (!EdramActiva() || !vista.edram_bpp || vista.edram_versiones.empty()) return;
+  auto& tejas = vista.profundidad ? tejas_z_ : tejas_color_;
+  const uint32_t n = TejasDeFilas(vista, std::min(filas, vista.alto));
+  if (!n) return;
+  // Its own claim leaves a view that was up to date still up to date.
+  uint32_t& generacion = vista.profundidad ? generacion_z_ : generacion_color_;
+  const bool al_dia = vista.edram_generacion == generacion;
+  ++generacion;
+  if (al_dia) vista.edram_generacion = generacion;
+  const uint32_t version = ++version_edram_;
+  for (uint32_t k = 0; k < n; ++k) {
+    TejaEdram& t = tejas[(vista.edram_base + k) & (kTejas - 1)];
+    t.dueno = &vista;
+    t.version = version;
+    t.borrada = borrado != nullptr;
+    if (borrado) std::copy(borrado, borrado + 4, t.valor);
+    vista.edram_versiones[k] = version;
+  }
+}
+
+void RenderDk::EdramCerrarPase() {
+  for (ImagenDk* imagen : imagenes_pase_) {
+    if (imagen && imagen->edram_filas) {
+      EdramReclamar(*imagen, imagen->edram_filas);
+      imagen->edram_filas = 0;
+    }
+  }
+}
+
+bool RenderDk::EdramShaders() {
+  if (edram_shaders_) return edram_shaders_ > 0;
+  edram_shaders_ = -1;
+  const deko::Compilador::Resultado c = compilador_.Compilar(false, std::string(kFsEdramComun) + kFsEdramColor);
+  const deko::Compilador::Resultado z = compilador_.Compilar(false, std::string(kFsEdramComun) + kFsEdramProfundidad);
+  if (!c.ok || !z.ok || !nucleo_.CargarShader(fs_edram_color_, c.dksh, "transferencia EDRAM (color)") ||
+      !nucleo_.CargarShader(fs_edram_z_, z.dksh, "transferencia EDRAM (profundidad)")) {
+    REXLOG_ERROR("[edram] no se pudieron compilar las transferencias: {} / {}", c.log, z.log);
+    return false;
+  }
+  edram_shaders_ = 1;
+  return true;
+}
+
+uint32_t RenderDk::VistaEstencil(const ImagenDk& imagen) {
+  constexpr uint16_t kMarca = 0xE5E5;  // a host swizzle no texture has: the key of the stencil views
+  const uint64_t clave = (imagen.serie << 24) ^ kMarca ^ (uint64_t(1) << 63);
+  if (const auto it = vistas_.find(clave); it != vistas_.end()) {
+    return it->second;
+  }
+  const uint32_t ranura = ReservarDescriptorImagen();
+  if (!ranura) return 0;
+  DkImageView v;
+  dkImageViewDefaults(&v, &imagen.imagen);
+  v.dsSource = DkDsSource_Stencil;
+  EscribirDescriptorImagen(ranura, v);
+  vistas_.emplace(clave, ranura);
+  vistas_por_serie_[imagen.serie].push_back(clave);
+  return ranura;
+}
+
+bool RenderDk::EdramTransferir(ImagenDk& origen, ImagenDk& destino, uint32_t desde, uint32_t cuantas) {
+  const Geometria gd = GeometriaDe(destino), go = GeometriaDe(origen);
+  const bool z = destino.profundidad;
+  const bool reinterpretar = !z && origen.edram_formato != destino.edram_formato;
+  // Only between views of the same sample size; 64-bit formats only as themselves.
+  if (origen.edram_bpp != destino.edram_bpp || (reinterpretar && destino.edram_bpp == 8)) {
+    ++edram_sin_soporte_;
+    const uint64_t aviso = (uint64_t(origen.edram_formato) << 8) | destino.edram_formato;
+    if (edram_avisos_.insert(aviso).second) {
+      REXLOG_WARN("[edram] {:03X}: formato {} ({} bits) visto como {} ({} bits): sin transferencia",
+                  destino.edram_base, origen.edram_formato, origen.edram_bpp * 8, destino.edram_formato,
+                  destino.edram_bpp * 8);
+    }
+    return false;
+  }
+  if (!vs_salida_valido_ || !EdramShaders()) return false;
+  // The destination rows those tiles cover, all of its width (the shader keeps the samples in the tiles).
+  const uint32_t filas_teja = 16 / gd.sy;
+  const uint32_t y0 = std::min((desde / gd.tejas_fila) * filas_teja, destino.alto);
+  const uint32_t y1 = std::min(((desde + cuantas - 1) / gd.tejas_fila + 1) * filas_teja, destino.alto);
+  const uint32_t ancho = std::min(destino.ancho, destino.edram_pitch);
+  if (y1 <= y0 || !ancho) return false;
+  // The source rows those tiles cover in it, for its pending work.
+  const uint32_t desde_o = (destino.edram_base + desde - origen.edram_base) & (kTejas - 1);
+  const uint32_t filas_o = std::min(((desde_o + cuantas - 1) / go.tejas_fila + 1) * (16 / go.sy), origen.alto);
+  RestaurarContenido(origen, true);
+  HacerBorradoPendiente(origen);
+  CompletarBanda(origen, filas_o, false, 0);
+  AntesDeCambiarDestino(&destino);
+  CompletarBanda(destino, y1, false, 0);
+
+  // GTA IV (x360_edram_z_por_pixel): its G-buffer's depth is drawn whole at 2x (gta4_sin_tiling) and put back for the
+  // lights at 1x with its bits written as color over the same EDRAM (a draw into c0 = the depth's base, k_8_8_8_8),
+  // which here never reaches the depth. The result of that is the same depth and stencil at the same pixels.
+  const bool por_pixel = z && REXCVAR_GET(x360_edram_z_por_pixel) && origen.edram_msaa == 1 &&
+                         destino.edram_msaa == 0 && origen.edram_base == destino.edram_base &&
+                         origen.edram_pitch == destino.edram_pitch;
+  AsegurarTrabajo();
+  EmitirCieloPendiente();
+  // The same pixels in images of the same format (x360_edram_z_por_pixel, 2x -> 1x): the copy engine moves depth and
+  // stencil in one copy, instead of a depth draw and eight stencil passes.
+  if (por_pixel && !edram_estencil_de_z_ && origen.formato == destino.formato && origen.ancho >= ancho &&
+      origen.alto >= y1) {
+    MarcarGpu(kGpuCopias);
+    AntesDeTransferir();
+    DkImageView vo, vd;
+    dkImageViewDefaults(&vo, &origen.imagen);
+    dkImageViewDefaults(&vd, &destino.imagen);
+    const DkImageRect rect = {0, y0, 0, ancho, y1 - y0, 1};
+    dkCmdBufCopyImage(nucleo_.comandos(), &vo, &rect, &vd, &rect, 0);
+    destino.edram_estencil |= origen.edram_estencil;
+    invalidar_zcull_ = true;
+    borrado_previo_.erase(destino.serie);
+    OlvidarEstado();
+    ++edram_transferencias_;
+    edram_pixeles_ += uint64_t(ancho) * (y1 - y0);
+    return true;
+  }
+  const deko::Subida ubo = Reservar(256, DK_UNIFORM_BUF_ALIGNMENT);
+  if (!ubo) return false;
+  const int32_t u[12] = {int32_t(destino.edram_base), int32_t(gd.tejas_fila),
+                         int32_t(gd.sx | (gd.sy << 4) | (gd.ancho_teja << 8)),
+                         int32_t(destino.edram_formato | (z && edram_estencil_de_z_ ? 0x100u : 0u)),
+                         int32_t(origen.edram_base), int32_t(go.tejas_fila),
+                         int32_t(go.sx | (go.sy << 4) | (go.ancho_teja << 8)), int32_t(origen.edram_formato),
+                         int32_t((destino.edram_base + desde) & (kTejas - 1)), int32_t(cuantas),
+                         reinterpretar ? 1 : 0, por_pixel ? 2 : 1};
+  std::memcpy(ubo.cpu, u, sizeof(u));
+  const uint32_t ranura = VistaDe(origen, 0x688, z ? 0 : 0x688);
+  const bool estencil = z && REXCVAR_GET(x360_edram_estencil);
+  // The stencil bit passes only for a source that ever held a stencil other than 0 (the first draw zeroes it).
+  const bool estencil_bits = estencil && origen.edram_estencil;
+  const uint32_t ranura_estencil = estencil ? VistaEstencil(origen) : 0;
+  DkCmdBuf cmd = nucleo_.comandos();
+  MarcarGpu(kGpuCopias);
+  // What wrote the source (draws, 3D copies, clears; a copy engine transfer needs the full barrier) is done and visible
+  // to the texture units. After other 3D copies only when this one depends on them (RenderDk::CopiaDependeDePendientes).
+  const bool barrera = transferencia_sin_barrera_ || rop_sin_barrera_ || fuerza_barrera_copia_ || invalidar_zcull_ ||
+                       (copia3d_pendiente_ && (!REXCVAR_GET(x360_copias_sin_barrera) ||
+                                               CopiaDependeDePendientes(origen.serie, destino.serie)));
+  if (barrera) {
+    if (transferencia_sin_barrera_) {
+      dkCmdBufBarrier(cmd, DkBarrier_Full, DkInvalidateFlags_Image | DkInvalidateFlags_Zcull);
+      ++barreras_;
+    } else {
+      dkCmdBufBarrier(cmd, DkBarrier_Fragments, DkInvalidateFlags_Image | DkInvalidateFlags_Zcull);
+      ++barreras_fragmentos_;
+    }
+    transferencia_sin_barrera_ = false;
+    rop_sin_barrera_ = false;
+    copia3d_pendiente_ = false;
+    copias3d_escritas_.clear();
+    copias3d_leidas_.clear();
+    fuerza_barrera_copia_ = false;
+    invalidar_zcull_ = false;
+  }
+  DkImageView vista;
+  dkImageViewDefaults(&vista, &destino.imagen);
+  if (z) {
+    dkCmdBufBindRenderTargets(cmd, nullptr, 0, &vista);
+  } else {
+    dkCmdBufBindRenderTarget(cmd, &vista, nullptr);
+  }
+  const DkViewport vp = {0.0f, float(y0), float(ancho), float(y1 - y0), 0.0f, 1.0f};
+  const DkScissor tijera = {0, y0, ancho, y1 - y0};
+  dkCmdBufSetViewports(cmd, 0, &vp, 1);
+  static const DkViewportSwizzle kIdentidad = {DkSwizzle_PositiveX, DkSwizzle_PositiveY, DkSwizzle_PositiveZ,
+                                                DkSwizzle_PositiveW};
+  dkCmdBufSetViewportSwizzles(cmd, 0, &kIdentidad, 1);
+  dkCmdBufSetScissors(cmd, 0, &tijera, 1);
+  DkRasterizerState rs;
+  dkRasterizerStateDefaults(&rs);
+  rs.cullMode = DkFace_None;
+  DkColorState cs;
+  dkColorStateDefaults(&cs);
+  DkColorWriteState cws;
+  dkColorWriteStateDefaults(&cws);
+  if (z) cws.masks = 0;
+  dkCmdBufBindRasterizerState(cmd, &rs);
+  dkCmdBufBindColorState(cmd, &cs);
+  dkCmdBufBindColorWriteState(cmd, &cws);
+  dkCmdBufBindVtxAttribState(cmd, nullptr, 0);
+  dkCmdBufBindVtxBufferState(cmd, nullptr, 0);
+  const DkShader* shaders[2] = {&vs_salida_, z ? &fs_edram_z_ : &fs_edram_color_};
+  dkCmdBufBindShaders(cmd, DkStageFlag_GraphicsMask, shaders, 2);
+  dkCmdBufBindTexture(cmd, DkStage_Fragment, 0, dkMakeTextureHandle(ranura, 0));
+  if (estencil && ranura_estencil) {
+    dkCmdBufBindTexture(cmd, DkStage_Fragment, 1, dkMakeTextureHandle(ranura_estencil, 0));
+  }
+  DkDepthStencilState ds;
+  dkDepthStencilStateDefaults(&ds);
+  ds.depthTestEnable = z;
+  ds.depthWriteEnable = z;
+  ds.depthCompareOp = DkCompareOp_Always;
+  // Depth: the stencil goes to 0 with the depth, then each bit is set where the source has it.
+  ds.stencilTestEnable = estencil && ranura_estencil;
+  ds.stencilFrontCompareOp = ds.stencilBackCompareOp = DkCompareOp_Always;
+  ds.stencilFrontPassOp = ds.stencilBackPassOp = DkStencilOp_Replace;
+  ds.stencilFrontFailOp = ds.stencilBackFailOp = DkStencilOp_Keep;
+  ds.stencilFrontDepthFailOp = ds.stencilBackDepthFailOp = DkStencilOp_Replace;
+  dkCmdBufBindDepthStencilState(cmd, &ds);
+  if (ds.stencilTestEnable) {
+    dkCmdBufSetStencil(cmd, DkFace_FrontAndBack, 0xFF, edram_estencil_de_z_ ? 0x80 : 0x00, 0xFF);
+  }
+  dkCmdBufBindUniformBuffer(cmd, DkStage_Fragment, 0, ubo.gpu, 256);
+  dkCmdBufDraw(cmd, DkPrimitive_Triangles, 3, 1, 0, 0);
+  if (ds.stencilTestEnable && estencil_bits) {
+    destino.edram_estencil = true;
+    ++edram_estencil_pasadas_;
+    ds.depthWriteEnable = false;
+    dkCmdBufBindDepthStencilState(cmd, &ds);
+    // GTA IV's restore rule (edram_estencil_de_z_): 0x80 everywhere from the first pass, then one pass of 0xFF where
+    // there is depth. Otherwise a pass per bit of the source's stencil.
+    const uint32_t pasadas = edram_estencil_de_z_ ? 1 : 8;
+    for (uint32_t bit = 0; bit < pasadas; ++bit) {
+      const deko::Subida b = Reservar(256, DK_UNIFORM_BUF_ALIGNMENT);
+      if (!b) break;
+      int32_t ub[12];
+      std::memcpy(ub, u, sizeof(ub));
+      ub[10] = int32_t(bit + 1);
+      std::memcpy(b.cpu, ub, sizeof(ub));
+      dkCmdBufSetStencil(cmd, DkFace_FrontAndBack, edram_estencil_de_z_ ? 0xFF : uint8_t(1u << bit), 0xFF, 0xFF);
+      dkCmdBufBindUniformBuffer(cmd, DkStage_Fragment, 0, b.gpu, 256);
+      dkCmdBufDraw(cmd, DkPrimitive_Triangles, 3, 1, 0, 0);
+    }
+  }
+  copia3d_pendiente_ = true;
+  AnotarCopia3D(origen.serie, destino.serie);
+  trabajo_3d_sin_barrera_ = true;
+  invalidar_zcull_ |= z;
+  borrado_previo_.erase(destino.serie);  // it holds other values than its last clear now
+  OlvidarEstado();
+  ++edram_transferencias_;
+  edram_pixeles_ += uint64_t(ancho) * (y1 - y0);
+  if (REXCVAR_GET(x360_edram_registro) || volcando_) {  // and in the frame the dump takes (ZL + ZR + Left)
+    REXLOG_INFO("[edram] {} {:03X} f{} {}{} -> {:03X} f{} {}{}: tejas {:03X}+{}, filas {}-{}", z ? "z" : "c",
+                origen.edram_base, origen.edram_formato, origen.edram_pitch,
+                origen.edram_msaa ? (origen.edram_msaa == 1 ? "/2x" : "/4x") : "", destino.edram_base,
+                destino.edram_formato, destino.edram_pitch,
+                destino.edram_msaa ? (destino.edram_msaa == 1 ? "/2x" : "/4x") : "",
+                (destino.edram_base + desde) & (kTejas - 1), cuantas, y0, y1);
+  }
+  return true;
+}
+
+// Tiles another view cleared and nothing wrote since, as a clear of the same rows in this one: what a transfer would
+// copy is that clear's value. Only whole tile rows, a value both views read the same way (the same format, or 0
+// everywhere) and for depth its z and stencil. false: the transfer draw does it.
+bool RenderDk::EdramBorrarComo(const ImagenDk& origen, const TejaEdram& teja, ImagenDk& destino, uint32_t desde,
+                               uint32_t cuantas) {
+  const Geometria gd = GeometriaDe(destino);
+  if (desde % gd.tejas_fila || cuantas % gd.tejas_fila) return false;
+  const bool z = destino.profundidad;
+  const bool ceros = !teja.valor[0] && !teja.valor[1] && !teja.valor[2] && !teja.valor[3];
+  if (!z && !ceros && (origen.edram_formato != destino.edram_formato || origen.edram_bpp != destino.edram_bpp)) {
+    return false;
+  }
+  const uint32_t filas_teja = 16 / gd.sy;
+  const uint32_t y0 = std::min((desde / gd.tejas_fila) * filas_teja, destino.alto);
+  const uint32_t y1 = std::min(((desde + cuantas) / gd.tejas_fila) * filas_teja, destino.alto);
+  const uint32_t ancho = std::min(destino.ancho, destino.edram_pitch);
+  if (y1 <= y0 || !ancho) return true;
+  AntesDeCambiarDestino(&destino);
+  CompletarBanda(destino, y1, false, 0);
+  AsegurarTrabajo();
+  EmitirCieloPendiente();
+  AntesDe3D();
+  MarcarGpu(kGpuBorrados);
+  DkCmdBuf cmd = nucleo_.comandos();
+  DkImageView vista;
+  dkImageViewDefaults(&vista, &destino.imagen);
+  const DkScissor tijera = {0, y0, ancho, y1 - y0};
+  if (z) {
+    dkCmdBufBindRenderTargets(cmd, nullptr, 0, &vista);
+    dkCmdBufSetScissors(cmd, 0, &tijera, 1);
+    const uint8_t estencil = uint8_t(teja.valor[1]);
+    dkCmdBufClearDepthStencil(cmd, true, teja.valor[0], 0xFF, estencil);
+    destino.edram_estencil |= estencil != 0;
+    invalidar_zcull_ = true;
+  } else {
+    dkCmdBufBindRenderTarget(cmd, &vista, nullptr);
+    dkCmdBufSetScissors(cmd, 0, &tijera, 1);
+    dkCmdBufClearColorFloat(cmd, 0, DkColorMask_RGBA, teja.valor[0], teja.valor[1], teja.valor[2], teja.valor[3]);
+  }
+  borrado_previo_.erase(destino.serie);
+  OlvidarEstado();
+  ++edram_borrados_;
+  if (REXCVAR_GET(x360_edram_registro) || volcando_) {
+    REXLOG_INFO("[edram] {} {:03X} f{} {} -> {:03X} f{} {}: tejas {:03X}+{}, filas {}-{}, como borrado", z ? "z" : "c",
+                origen.edram_base, origen.edram_formato, origen.edram_pitch, destino.edram_base, destino.edram_formato,
+                destino.edram_pitch, (destino.edram_base + desde) & (kTejas - 1), cuantas, y0, y1);
+  }
+  return true;
+}
+
+bool RenderDk::EdramZPorColor(ImagenDk& z) {
+  if (!EdramActiva() || !REXCVAR_GET(x360_edram_z_por_color) || !z.edram_bpp) return false;
+  const auto base = z_resuelta_por_base_.find(z.edram_base);
+  const auto it = base == z_resuelta_por_base_.end() ? resueltas_.end() : resueltas_.find(base->second);
+  const char* falta = base == z_resuelta_por_base_.end()  ? "ninguna resuelta de profundidad de esa base"
+                      : it == resueltas_.end()             ? "la resuelta ya no existe"
+                      : !it->second.escrita                ? "la resuelta no esta escrita"
+                      : !it->second.imagen.profundidad     ? "la resuelta no es de profundidad"
+                      : it->second.imagen.ancho != z.edram_pitch ? "la resuelta tiene otro ancho"
+                                                                 : nullptr;
+  if (falta) {
+    if (edram_z_por_color_registrados_ < 8) {
+      ++edram_z_por_color_registrados_;
+      REXLOG_INFO("[edram] profundidad {:03X} ({}) por color: no se restaura, {}", z.edram_base, z.edram_pitch, falta);
+    }
+    return false;
+  }
+  const uint64_t hecho[3] = {z.serie, it->second.imagen.serie, it->second.imagen.version};
+  if (std::equal(hecho, hecho + 3, z_por_color_hecho_)) return true;  // already done for this pass
+  std::copy(hecho, hecho + 3, z_por_color_hecho_);
+  // The texture as a 2x view of the same base and pitch: EdramTransferir copies it pixel for pixel
+  // (x360_edram_z_por_pixel's path), with its stencil.
+  ImagenDk fuente = it->second.imagen;
+  fuente.edram_base = z.edram_base;
+  fuente.edram_pitch = z.edram_pitch;
+  fuente.edram_msaa = 1;
+  fuente.edram_bpp = 4;
+  fuente.edram_formato = z.edram_formato;
+  fuente.edram_estencil = true;
+  fuente.contenido_invalido = false;
+  fuente.borrado_pendiente = false;
+  fuente.banda_sucia = false;
+  const uint32_t filas = std::min(z.alto, fuente.alto);
+  RestaurarContenido(z, true);
+  HacerBorradoPendiente(z);
+  // GTA IV's restore (its pixel shader, ps_b3d105989610e354) writes the stencil as 1.0 where the depth bytes are not 0
+  // and 0.5 where they are: 0xFF on geometry, 0x80 on the sky. Its full-screen sun and ambient light tests that.
+  edram_estencil_de_z_ = true;
+  const bool hecho_ok = EdramTransferir(fuente, z, 0, TejasDeFilas(z, filas));
+  edram_estencil_de_z_ = false;
+  if (!hecho_ok) return false;
+  EdramReclamar(z, filas);
+  z.edram_estencil = true;
+  if (edram_z_por_color_registrados_ < 8) {
+    ++edram_z_por_color_registrados_;
+    REXLOG_INFO("[edram] profundidad {:03X} ({}) restaurada desde la resuelta {:08X} ({}x{})", z.edram_base,
+                z.edram_pitch, base->second, fuente.ancho, fuente.alto);
+  }
+  return true;
+}
+
+// Once per frame (Presentar): every 300 frames, what the transfers cost.
+void RenderDk::EdramFotograma() {
+  if (!EdramActiva() || ++edram_fotogramas_ < 300) return;
+  REXLOG_INFO("[edram] {} fotogramas: {:.1f} transferencias ({:.1f} con stencil) y {:.2f} Mpixeles por fotograma, "
+              "{:.1f} hechas como borrado, {} sin soporte",
+              edram_fotogramas_, double(edram_transferencias_) / edram_fotogramas_,
+              double(edram_estencil_pasadas_) / edram_fotogramas_, double(edram_pixeles_) / edram_fotogramas_ / 1e6,
+              double(edram_borrados_) / edram_fotogramas_, edram_sin_soporte_);
+  edram_fotogramas_ = 0;
+  edram_transferencias_ = edram_pixeles_ = edram_sin_soporte_ = edram_borrados_ = edram_estencil_pasadas_ = 0;
+}
