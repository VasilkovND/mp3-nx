+// The diagnostic frame's resolved textures as they are when it ends: copies after all its work, so that frame is drawn
+// as any other (the dump's copies at each resolve go with a full barrier, and the black quarter of run31 was not in it).
+void RenderDk::InstantaneaDiagnostico() {
+  if (!edram_diag_ || volcando_ || diag_instantaneas_ >= uint32_t(std::max(REXCVAR_GET(x360_diag_instantanea), 0))) {
+    return;
+  }
+  ++diag_instantaneas_;
+  if (!volcado_bloque_) {
+    volcado_bloque_ = nucleo_.CrearBloqueLectura(kBytesVolcado, "volcado de un fotograma");
+    volcado_cpu_ = static_cast<uint8_t*>(dkMemBlockGetCpuAddr(volcado_bloque_));
+    volcado_gpu_ = dkMemBlockGetGpuAddr(volcado_bloque_);
+  }
+  if (!volcado_bloque_) return;
+  dkMemBlockFlushCpuCache(volcado_bloque_, 0, kBytesVolcado);
+  volcado_usados_ = 0;
+  volcado_.clear();
+  AsegurarTrabajo();
+  const std::string bases = REXCVAR_GET(x360_diag_instantanea_bases);
+  for (size_t p = 0; p < bases.size();) {
+    size_t q = bases.find(',', p);
+    if (q == std::string::npos) q = bases.size();
+    const uint32_t base = uint32_t(std::strtoul(bases.substr(p, q - p).c_str(), nullptr, 16));
+    p = q + 1;
+    if (const auto it = resueltas_.find(base); it != resueltas_.end() && it->second.imagen.viva) {
+      VolcarResuelta(it->second.imagen, base, it->second.formato_guest);
+    }
+  }
+  REXLOG_INFO("[edram-diag] instantanea en vivo: {} texturas", volcado_.size());
+  if (!volcado_.empty()) {
+    volcando_ = true;  // TerminarVolcado's state
+    TerminarVolcado();
+  }
+}
